# ============================================================================
# EventFlow frontend — environment template
# ============================================================================
# Copy this file to .env for local development (git-ignored).
#
# For Vercel / Netlify / Firebase Hosting, set the same keys in the platform
# dashboard (Project Settings → Environment Variables), NOT in a committed file.
#
# SECURITY: every VITE_* value is compiled into the JavaScript bundle and is
# readable by anyone who loads the site. They must be public-by-design values.
# Never put a database password, JWT secret, or private API key here — those
# belong to the backend only.
# ============================================================================

# ---------------------------------------------------------------------------
# Backend API
# ---------------------------------------------------------------------------
# Base URL of the Spring Boot API, including the context path.
# Local:      http://localhost:8080/api/eventflow
# Deployed:   https://your-backend-host.example/api/eventflow
# While unset, src/api/client.js falls back to the local URL.
VITE_API_BASE_URL=http://localhost:8080/api/eventflow

# ---------------------------------------------------------------------------
# Firebase (Cloud Messaging only)
# ---------------------------------------------------------------------------
# All six values below are REQUIRED — src/firebase/config.js throws at boot if
# any is missing (that guard is intentional, it catches misconfigured deploys).
#
# Where to get them:
#   Firebase Console → your project → ⚙ Project settings → General
#   → "Your apps" → Web app → SDK setup and configuration → Config
VITE_FIREBASE_API_KEY=your_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=123456789
VITE_FIREBASE_APP_ID=1:123456789:web:abcdef123456

# Optional — analytics measurement ID. Safe to omit; push notifications do not
# use it. Firebase Console → Project settings → General → Config.
VITE_FIREBASE_MEASUREMENT_ID=G-XXXXXXXXXX

# REQUIRED for web push to work at all; without it messaging.js silently
# returns null and the browser never receives a token.
# Firebase Console → Project settings → Cloud Messaging
#   → "Web Push certificates" → Key pair → copy the public key
VITE_FIREBASE_VAPID_KEY=your_vapid_key_here
